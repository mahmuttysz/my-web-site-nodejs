<%- include('partials/header') %>

    <div class="hero-parallax-bg relative h-[60vh] flex items-center justify-center text-center px-4">
        <div class="max-w-xl">
            <div class="flex items-center justify-center gap-2 mb-6">
                <a href="/lang/tr"
                    class="text-xs font-bold px-2.5 py-1 rounded-md transition-all <%= lang === 'tr' ? 'border border-site-accent bg-site-accent/10 text-site-accent' : 'text-site-muted hover:text-site-text' %>">TR</a>
                <span class="text-site-border">|</span>
                <a href="/lang/en"
                    class="text-xs font-bold px-2.5 py-1 rounded-md transition-all <%= lang === 'en' ? 'border border-site-accent bg-site-accent/10 text-site-accent' : 'text-site-muted hover:text-site-text' %>">EN</a>
            </div>
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-2 text-site-text">Mahmut Tüysüz</h1>
            <div class="text-site-accent text-lg font-semibold tracking-wider uppercase">
                <%= t.hero.badge %>
            </div>
        </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-16 sm:space-y-20">
        <section id="about">
            <h2
                class="text-xl sm:text-2xl font-bold tracking-tight mb-6 pb-2 border-b border-site-border flex items-center gap-2 text-site-text before:content-['//'] before:text-site-accent">
                <%= aboutMe && aboutMe.title ? aboutMe.title : t.nav.aboutMe %>
            </h2>
            <p class="text-site-muted text-base leading-relaxed whitespace-pre-line">
                <%= aboutMe && aboutMe.description ? aboutMe.description : t.hero.desc %>
            </p>
            <div class="flex justify-end mt-6">
                <a href="#contact" id="goToContactBtn"
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-white/5 border border-white/15 text-slate-200 rounded-md text-sm font-medium transition-all duration-200 hover:bg-white/10 hover:border-site-accent hover:text-site-accent hover:-translate-y-0.5 group">
                    <span>
                        <%= t.button.contact %>
                    </span>
                    <span class="text-xs transition-transform duration-200 group-hover:translate-y-0.5">&darr;</span>
                </a>
            </div>
        </section>

        <section id="projects">
            <h2
                class="text-xl sm:text-2xl font-bold tracking-tight mb-6 pb-2 border-b border-site-border flex items-center gap-2 text-site-text before:content-['//'] before:text-site-accent">
                <%= t.nav.projects %>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% if (projects && projects.length> 0) { %>
                    <% projects.forEach(project=> { %>
                        <div
                            class="bg-site-card border border-site-border p-6 rounded-xl flex flex-col justify-between transition-all duration-200 hover:border-site-accent hover:-translate-y-0.5">
                            <div class="mb-6">
                                <div class="flex items-center justify-between gap-2 mb-3">
                                    <h3 class="text-lg font-bold text-site-text">
                                        <%= project.title %>
                                    </h3>
                                    <% if (project.link_url) { %>
                                        <a href="<%= project.link_url %>" target="_blank" rel="noopener noreferrer"
                                            class="text-site-accent text-sm font-medium hover:underline shrink-0">
                                            <%= project.link_text || t.alert.learnMore %> ↗
                                        </a>
                                        <% } %>
                                </div>
                                <p class="text-site-muted text-sm leading-relaxed">
                                    <%= project.description %>
                                </p>
                            </div>
                            <% let tagList=[]; if (Array.isArray(project.tags)) { tagList=project.tags; } else if
                                (typeof project.tags==='string' && project.tags.trim() !=='' ) { try {
                                tagList=JSON.parse(project.tags); } catch(e) { tagList=project.tags.split(',').map(t=>
                                t.trim());
                                }
                                }
                                %>
                                <% if (tagList && tagList.length> 0) { %>
                                    <div class="flex flex-wrap gap-2">
                                        <% tagList.forEach(tag=> { %>
                                            <span
                                                class="bg-site-accent/10 text-site-accent text-xs px-2.5 py-1 rounded font-medium">
                                                <%= tag %>
                                            </span>
                                            <% }); %>
                                    </div>
                                    <% } %>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <p class="text-site-muted text-sm col-span-full">
                                    <%= t.alert.doesntAddedProjects %>
                                </p>
                                <% } %>
            </div>
        </section>

        <section id="blog">
            <div class="flex items-center justify-between mb-6 pb-2 border-b border-site-border">
                <h2
                    class="text-xl sm:text-2xl font-bold tracking-tight text-site-text flex items-center gap-2 before:content-['//'] before:text-site-accent">
                    <%= t.nav.blog %>
                </h2>
                <% if (articles && articles.length> 0) { %>
                    <a href="/blog"
                        class="text-site-muted hover:text-site-accent text-sm font-medium inline-flex items-center gap-1 transition-colors group">
                        <%= t.alert.viewAll %>
                            <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                    </a>
                    <% } %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% if (articles && articles.length> 0) { %>
                    <% articles.forEach(article=> { %>
                        <div
                            class="bg-site-card border border-site-border p-5 rounded-xl flex flex-col justify-between transition-all duration-200 hover:border-site-accent hover:-translate-y-0.5 group">
                            <div>
                                <% if (article.cover_image) { %>
                                    <a href="/blog/<%= article.slug %>"
                                        class="block w-full aspect-video overflow-hidden rounded-lg mb-4 bg-slate-900">
                                        <img src="<%= article.cover_image %>" alt="<%= article.title %>"
                                            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                                            loading="lazy" />
                                    </a>
                                    <% } %>
                                        <div class="text-xs text-slate-500 font-medium mb-1.5">
                                            <%= formatLongDate(article.created_at, lang) %>
                                        </div>
                                        <h3
                                            class="text-lg font-bold leading-snug mb-2 text-slate-100 group-hover:text-site-accent transition-colors">
                                            <a href="/blog/<%= article.slug %>">
                                                <%= article.title %>
                                            </a>
                                        </h3>
                                        <p class="text-slate-400 text-sm leading-relaxed mb-4 line-clamp-3">
                                            <%= article.excerpt || (article.content ? article.content.substring(0, 120)
                                                + '...' : '' ) %>
                                        </p>
                            </div>
                            <div class="pt-2 border-t border-site-border/50">
                                <a href="/blog/<%= article.slug %>"
                                    class="text-site-accent text-sm font-semibold inline-flex items-center gap-1 hover:underline">
                                    <%= t.alert.readMore %> ↗
                                </a>
                            </div>
                        </div>
                        <% }); } else { %>
                            <p class="text-site-muted text-sm col-span-full">
                                <%= t.alert.doesntAddedArticles %>
                            </p>
                            <% } %>
            </div>
        </section>

        <section id="experiences">
            <h2
                class="text-xl sm:text-2xl font-bold tracking-tight mb-6 pb-2 border-b border-site-border flex items-center gap-2 text-site-text before:content-['//'] before:text-site-accent">
                <%= t.nav.experiences %>
            </h2>

            <div class="relative border-l-2 border-site-border pl-6 sm:pl-7 ml-2 space-y-8 sm:space-y-10">
                <% if (experiences && experiences.length> 0) { %>
                    <% experiences.forEach(experience=> { %>
                        <div class="relative timeline-dot">
                            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-1">
                                <h3 class="text-lg font-bold text-site-text">
                                    <%= experience.title %>
                                </h3>
                                <span class="text-site-muted text-xs sm:text-sm">
                                    <%= formatDate(experience.begin_date, lang) %> —
                                        <%= formatDate(experience.end_date, lang) %>
                                </span>
                            </div>
                            <div class="text-site-accent font-medium text-sm mb-2">
                                <%= experience.company_name %>
                            </div>
                            <p class="text-site-muted text-sm leading-relaxed whitespace-pre-line">
                                <%= experience.description %>
                            </p>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <p class="text-site-muted text-sm">
                                    <%= t.alert.doesntAddedExperiences %>
                                </p>
                                <% } %>
            </div>
        </section>

        <section id="contact">
            <h2
                class="text-xl sm:text-2xl font-bold tracking-tight mb-6 pb-2 border-b border-site-border flex items-center gap-2 text-site-text before:content-['//'] before:text-site-accent">
                <%= t.form.title %>
            </h2>
            <div id="formMessage" class="hidden mb-4 p-4 rounded-md text-sm font-medium"></div>
            <form class="bg-site-card border border-site-border p-6 sm:p-8 rounded-xl space-y-5" id="contactForm">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label for="name" class="text-xs font-semibold text-site-muted uppercase tracking-wider">
                            <%= t.form.fullName %>
                        </label>
                        <input type="text" id="name" name="fullName" autocomplete="off"
                            placeholder="<%= t.form.fullName %>"
                            class="bg-site-bg border border-site-border text-site-text p-3 rounded-md focus:outline-none focus:border-site-accent text-sm"
                            required />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label for="email" class="text-xs font-semibold text-site-muted uppercase tracking-wider">
                            <%= t.form.email %>
                        </label>
                        <input type="email" id="email" name="email" autocomplete="off" placeholder="<%= t.form.email %>"
                            class="bg-site-bg border border-site-border text-site-text p-3 rounded-md focus:outline-none focus:border-site-accent text-sm"
                            required />
                    </div>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label for="subject" class="text-xs font-semibold text-site-muted uppercase tracking-wider">
                        <%= t.form.subject %>
                    </label>
                    <input type="text" id="subject" name="subject" autocomplete="off"
                        placeholder="<%= t.form.subject %>"
                        class="bg-site-bg border border-site-border text-site-text p-3 rounded-md focus:outline-none focus:border-site-accent text-sm" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label for="message" class="text-xs font-semibold text-site-muted uppercase tracking-wider">
                        <%= t.form.message %>
                    </label>
                    <textarea id="message" name="message" rows="5" placeholder="<%= t.form.message %>"
                        class="bg-site-bg border border-site-border text-site-text p-3 rounded-md focus:outline-none focus:border-site-accent text-sm resize-none"
                        required></textarea>
                </div>
                <div class="turnstile-box flex justify-start">
                    <div id="turnstile-container"></div>
                </div>
                <button type="submit" id="sendBtn"
                    class="w-full bg-site-accent text-site-bg font-bold py-3.5 px-6 rounded-md uppercase tracking-wider text-sm hover:opacity-90 transition-opacity disabled:opacity-50 cursor-pointer">
                    <%= t.form.send %>
                </button>
            </form>
            <script>
                window.onloadTurnstileCallback = function () {
                    if (window.turnstile) {
                        turnstile.render('#turnstile-container', {
                            sitekey: '<%= turnstileSiteKey %>',
                            theme: 'dark',
                            size: 'normal',
                            'expired-callback': function () {
                                turnstile.reset('#turnstile-container');
                            }
                        });
                    }
                };
            </script>
            <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback" async
                defer></script>
        </section>
    </div>

    <%- include('partials/footer') %>