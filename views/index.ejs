<!DOCTYPE html>
<html lang="tr">

<head>
    <%- include('partials/head') %>
</head>

<body>

    <%- include('partials/header') %>

        <div class="wrapper">
            <!-- Hakkımda -->
            <section id="about">
                <h2>
                    <%= aboutMe && aboutMe.title ? aboutMe.title : "Hakkımda" %>
                </h2>
                <p class="about-text">
                    <%= aboutMe && aboutMe.description ? aboutMe.description
                        : "Senior Software Developer & DevOps Uzmanı. Ölçeklenebilir sistemler ve modern web teknolojileri geliştiriyorum."
                        %>
                </p>
            </section>

            <!-- Deneyim Zaman Tüneli -->
            <section id="experience">
                <h2>Deneyimler</h2>
                <div class="timeline">
                    <% if (experiences && experiences.length> 0) { %>
                        <% experiences.forEach(experience=> { %>
                            <div class="timeline-item">
                                <div class="job-header">
                                    <div class="job-title">
                                        <%= experience.title %>
                                    </div>
                                    <div class="job-date">
                                        <%= formatDate(experience.begin_date) %>
                                            — <%= formatDate(experience.end_date) || "Devam Ediyor" %>
                                    </div>
                                </div>
                                <div class="job-company">
                                    <%= experience.company_name %>
                                </div>
                                <p class="job-desc">
                                    <%= experience.description %>
                                </p>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <p>Henüz deneyim eklenmemiş.</p>
                                    <% } %>
                </div>
            </section>

            <!-- İletişim Formu -->
            <section id="contact">
                <h2>İletişim</h2>
                <div id="formMessage"></div>
                <form class="contact-form" id="contactForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name">İsim</label>
                            <input type="text" id="name" name="fullName" placeholder="Adınız Soyadınız" required>
                        </div>
                        <div class="form-group">
                            <label for="email">E-posta</label>
                            <input type="email" id="email" name="email" placeholder="E-Posta Adresiniz" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="subject">Konu</label>
                        <input type="text" id="subject" name="subject" placeholder="Konu">
                    </div>
                    <div class="form-group">
                        <label for="message">Mesaj</label>
                        <textarea id="message" name="message" rows="5" placeholder="Mesajınız" required></textarea>
                    </div>
                    <button type="submit" id="gonderBtn">Mesaj Gönder</button>
                </form>
            </section>
        </div>
        <%- include('partials/footer') %>
</body>

</html>