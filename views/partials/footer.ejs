<footer class="site-footer">
    <div class="footer-container">
        <div class="footer-col footer-brand">
            <h3 class="footer-logo">Mahmut Tüysüz</h3>
            <p class="footer-desc">
                <%= (t.footer && t.footer.desc) ? t.footer.desc : t.hero.desc %>
            </p>
        </div>
        <div class="footer-col">
            <h4>
                <%= t.nav.contact %>
            </h4>
            <div class="social-links">
                <% if (socialMedias && socialMedias.length> 0) { %>
                    <% socialMedias.forEach(social=> { %>
                        <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer"
                            aria-label="<%= social.name %>">
                            <%- social.icon %>
                                <span>
                                    <%= social.title %>
                                </span>
                        </a>
                        <% }); } %>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="footer-bottom-container">
            <p>
                &copy; <%= new Date().getFullYear() %> Mahmut Tüysüz. <%=t.footer.rights%>
            </p>
            <p class="tech-stack">
                <%= t.footer.techStack %>
            </p>
        </div>
    </div>
</footer>

<script src="<%= siteUrl %>/js/main.js"></script>
</body>

</html>