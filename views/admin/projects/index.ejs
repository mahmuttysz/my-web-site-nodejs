<%- include('../partials/header') %>
    <div class="flex min-h-screen flex-col lg:flex-row">
        <%- include('../partials/sidebar') %>
            <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8 overflow-y-auto">
                <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6 lg:mb-8">
                    <div class="min-w-0">
                        <h1 class="text-xl sm:text-2xl font-bold text-white">
                            Proje Yönetimi
                        </h1>
                    </div>
                    <a href="<%=adminEndpoint%>/projects/new"
                        class="inline-flex justify-center shrink-0 px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-sm font-medium transition-colors">
                        + Proje Ekle
                    </a>
                </header>
                <% if (projects && projects.length> 0) { %>
                    <div class="lg:hidden space-y-3">
                        <% projects.forEach((prj)=> { %>
                            <article class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-3">
                                <div class="flex items-start justify-between gap-3">
                                    <h2 class="font-medium text-white leading-snug">
                                        <%= prj.title %>
                                    </h2>
                                    <span class="shrink-0 px-2.5 py-1 rounded-full text-xs font-semibold <%= prj.status === 1 ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-slate-800 text-slate-400' %>">
                                        <%= prj.status===1 ? 'Aktif' : 'Pasif' %>
                                    </span>
                                </div>
                                <dl class="grid grid-cols-2 gap-x-3 gap-y-1.5 text-xs text-slate-400">
                                    <div>
                                        <dt class="text-slate-500">Dil</dt>
                                        <dd class="uppercase"><%= prj.language || 'tr' %></dd>
                                    </div>
                                    <div>
                                        <dt class="text-slate-500">Link</dt>
                                        <dd>
                                            <% if (prj.link_url) { %>
                                                <a href="<%= prj.link_url %>" target="_blank" rel="noopener noreferrer" class="text-sky-400">
                                                    <%= prj.link_text || 'Aç' %> ↗
                                                </a>
                                            <% } else { %>-<% } %>
                                        </dd>
                                    </div>
                                    <div class="col-span-2">
                                        <dt class="text-slate-500">Oluşturulma</dt>
                                        <dd><%= formatLongDateTime(prj.created_at) %></dd>
                                    </div>
                                </dl>
                                <% let tagList=[]; if (Array.isArray(prj.tags)) { tagList=prj.tags; } else if (typeof prj.tags==='string' && prj.tags.trim() !=='' ) { try { tagList=JSON.parse(prj.tags); } catch(e) { tagList=prj.tags.split(',').map(t=> t.trim()); } } %>
                                <% if (tagList && tagList.length> 0) { %>
                                    <div class="flex flex-wrap gap-1.5">
                                        <% tagList.forEach(tag=> { %>
                                            <span class="px-2 py-0.5 rounded-full text-xs bg-slate-800 text-slate-400"><%= tag %></span>
                                        <% }); %>
                                    </div>
                                <% } %>
                                <%- include('../partials/crud-actions', { editHref: adminEndpoint + '/projects/edit/' + prj.id, adminEndpoint: adminEndpoint, pageEndpoint: 'projects', itemId: prj.id }) %>
                            </article>
                        <% }); %>
                    </div>
                    <div class="hidden lg:block bg-slate-900 border border-slate-800 rounded-xl overflow-x-auto">
                        <table class="w-full min-w-[64rem] text-left text-sm text-slate-300">
                            <thead class="bg-slate-950 border-b border-slate-800 text-xs uppercase text-slate-400">
                                <tr>
                                    <th class="px-6 py-4">#</th>
                                    <th class="px-6 py-4">Başlık</th>
                                    <th class="px-6 py-4">Link</th>
                                    <th class="px-6 py-4">Tags</th>
                                    <th class="px-6 py-4">Oluşturulma Tarihi</th>
                                    <th class="px-6 py-4">Dil</th>
                                    <th class="px-6 py-4">Durum</th>
                                    <th class="px-6 py-4 text-right">Aksiyonlar</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800">
                                <% projects.forEach((prj, i)=> { %>
                                    <tr class="hover:bg-slate-800/30">
                                        <td class="px-6 py-4 text-slate-400"><%= i+1 %></td>
                                        <td class="px-6 py-4 font-medium text-white max-w-xs truncate"><%= prj.title %></td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <% if (prj.link_url) { %>
                                                <a href="<%= prj.link_url %>" target="_blank" rel="noopener noreferrer">
                                                    <%= prj.link_text %> ↗
                                                </a>
                                            <% } else { %>-<% } %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <% let tableTags=[]; if (Array.isArray(prj.tags)) { tableTags=prj.tags; } else if (typeof prj.tags==='string' && prj.tags.trim() !=='' ) { try { tableTags=JSON.parse(prj.tags); } catch(e) { tableTags=prj.tags.split(',').map(t=> t.trim()); } } %>
                                            <% if (tableTags && tableTags.length> 0) { tableTags.forEach(tag => { %>
                                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-800 text-slate-400"><%= tag %></span>
                                            <% }); } else { %>-<% } %>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400 whitespace-nowrap"><%= formatLongDateTime(prj.created_at) %></td>
                                        <td class="px-6 py-4 text-slate-400 uppercase"><%= prj.language || 'tr' %></td>
                                        <td class="px-6 py-4">
                                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= prj.status === 1 ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-slate-800 text-slate-400' %>">
                                                <%= prj.status===1 ? 'Aktif' : 'Pasif' %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <%- include('../partials/crud-actions', { editHref: adminEndpoint + '/projects/edit/' + prj.id, adminEndpoint: adminEndpoint, pageEndpoint: 'projects', itemId: prj.id, align: 'end' }) %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="bg-slate-900 border border-slate-800 rounded-xl px-6 py-8 text-center text-slate-500">
                        Henüz proje eklenmemiş.
                    </div>
                <% } %>
            </main>
    </div>
    <%- include('../partials/footer') %>
