<%- include('../partials/header') %>
    <div class="flex min-h-screen">
        <%- include('../partials/sidebar') %>
            <main class="flex-1 p-8 overflow-y-auto">
                <header class="flex items-center justify-between mb-8">
                    <div>
                        <h1 class="text-2xl font-bold text-white">
                            <%= project.id ? 'Projeyi Düzenle' : 'Yeni Proje Ekle' %>
                        </h1>
                    </div>
                    <a href="<%=adminEndpoint%>/projects"
                        class="text-xs text-slate-400 hover:text-white transition-colors">
                        ← İptal ve Geri Dön</a>
                </header>
                <form
                    action="<%= project.id ? adminEndpoint + '/projects/edit/' + project.id : adminEndpoint + '/projects/create' %>"
                    method="POST" class="space-y-6 max-w-4xl">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                                Proje Başlığı
                            </label>
                            <input type="text" name="title" value="<%= project.title || '' %>" required
                                placeholder="Örn: Node.JS Projem"
                                class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:border-blue-500" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                                Proje Link Yazısı
                            </label>
                            <input type="text" name="link_text" value="<%= project.link_text || '' %>"
                                placeholder="GitHub"
                                class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-slate-300 text-sm focus:outline-none focus:border-blue-500">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                                Proje Linki
                            </label>
                            <input type="text" name="link_url" value="<%= project.link_url || '' %>"
                                placeholder="https://github.com/mahmuttysz/ornek-proje"
                                class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-slate-300 text-sm focus:outline-none focus:border-blue-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                            Açıklama
                        </label>
                        <textarea name="description" rows="16" required
                            placeholder="# Başlık 1&#10;&#10;Paragraf metni buraya gelecek..."
                            class="w-full bg-slate-900 border border-slate-800 rounded-lg p-4 font-mono text-sm text-slate-200 focus:outline-none focus:border-blue-500 leading-relaxed"><%= project.description || '' %></textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                            Tags
                        </label>
                        <input type="text" name="tags" value="<%= project.tagsTxt || '' %>" placeholder="Node.JS, C#"
                            class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-slate-300 text-sm focus:outline-none focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                            Sıra
                        </label>
                        <input type="number" name="turn" value="<%= project.turn || 1 %>"
                            class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-slate-300 text-sm focus:outline-none focus:border-blue-500">
                    </div>
                    <div class="flex items-center justify-between pt-4 border-t border-slate-800">
                        <div class="flex items-center gap-4">
                            <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                Durumu:
                            </label>
                            <select name="status"
                                class="bg-slate-900 border border-slate-800 text-sm text-white rounded-lg px-3 py-2 focus:outline-none">
                                <option value="0" <%=project.status===0 ? 'selected' : '' %>>
                                    Pasif
                                </option>
                                <option value="1" <%=project.status===1 ? 'selected' : '' %>>
                                    Aktif
                                </option>
                            </select>
                        </div>
                        <div class="flex items-center gap-4">
                            <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                Dil:
                            </label>
                            <select name="language"
                                class="bg-slate-900 border border-slate-800 text-sm text-white rounded-lg px-3 py-2 focus:outline-none">
                                <option value="tr" <%=project.language==='tr' ? 'selected' : '' %>>
                                    Türkçe
                                </option>
                                <option value="en" <%=project.language==='en' ? 'selected' : '' %>>
                                    İngilizce
                                </option>
                            </select>
                        </div>
                        <button type="submit"
                            class="px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-sm font-medium transition-colors">
                            <%= project.id ? 'Değişiklikleri Kaydet' : 'Projeyi Kaydet' %>
                        </button>
                    </div>
                </form>
            </main>
    </div>
    <%- include('../partials/footer') %>