<%- include('../partials/header') %>
    <div class="flex min-h-screen">
        <%- include('../partials/sidebar') %>
            <main class="flex-1 p-8 overflow-y-auto">
                <header class="flex items-center justify-between mb-8">
                    <div>
                        <h1 class="text-2xl font-bold text-white">
                            <%= article.id ? 'Makaleyi Düzenle' : 'Yeni Makale Ekle' %>
                        </h1>
                        <p class="text-slate-400 text-sm mt-1">İçeriğinizi Markdown formatında kaleme alabilirsiniz.</p>
                    </div>
                    <div class="flex items-center gap-4">
                        <a href="<%=adminEndpoint%>/articles"
                            class="text-xs text-slate-400 hover:text-white transition-colors">
                            ← İptal ve Geri Dön</a>
                        <% const published = Number(article.status) === 1; %>
                        <% if (article.preview_token && !published) { %>
                            <a href="<%= (article.language === 'en' ? '/en' : '') + '/blog/_preview/' + article.preview_token %>"
                                target="_blank" rel="noopener noreferrer"
                                class="text-xs text-emerald-400 hover:text-emerald-300 transition-colors">
                                Taslağı önizle ↗
                            </a>
                        <% } else if (published && article.slug) { %>
                            <a href="<%= (article.language === 'en' ? '/en' : '') + '/blog/' + article.slug %>"
                                target="_blank" rel="noopener noreferrer"
                                class="text-xs text-emerald-400 hover:text-emerald-300 transition-colors">
                                Yayındaki yazı ↗
                            </a>
                        <% } %>
                    </div>
                </header>
                <form
                    action="<%= article.id ? adminEndpoint + '/articles/edit/' + article.id : adminEndpoint + '/articles/create' %>"
                    method="POST" enctype="multipart/form-data" class="space-y-6 max-w-4xl">
                    <%- include('../partials/csrf') %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                                Makale Başlığı
                            </label>
                            <input type="text" name="title" value="<%= article.title || '' %>" required
                                placeholder="Örn: Node.js ile Mükemmel Performans"
                                class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:border-blue-500" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                                URL Slug (İsteğe Bağlı)
                            </label>
                            <input type="text" name="slug" value="<%= article.slug || '' %>"
                                placeholder="nodejs-ile-mukemmel-performans"
                                class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-slate-300 text-sm focus:outline-none focus:border-blue-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                            Kısa Özet (Excerpt)
                        </label>
                        <textarea name="excerpt" rows="2"
                            placeholder="Listeleme sayfalarında görünecek kısa açıklama..."
                            class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:border-blue-500"><%= article.excerpt || '' %></textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                            Kapak Görseli
                        </label>
                        <% if (article.cover_image) { %>
                            <div class="mb-3 flex items-center gap-4">
                                <img src="<%= article.cover_image %>"
                                    class="w-20 h-12 object-cover rounded border border-slate-800" />
                                <input type="hidden" name="existing_cover_image" value="<%=article.cover_image%>" />
                                <span class="text-xs text-slate-500">
                                    Mevcut Kapak Görseli
                                </span>
                            </div>
                            <% } %>
                                <input type="file" name="cover_image" accept="image/*"
                                    class="block w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-slate-300 hover:file:bg-slate-700">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                            İçerik (Markdown Formatında)
                        </label>
                        <textarea name="content" rows="16" required
                            placeholder="# Başlık 1&#10;&#10;Paragraf metni buraya gelecek..."
                            class="w-full bg-slate-900 border border-slate-800 rounded-lg p-4 font-mono text-sm text-slate-200 focus:outline-none focus:border-blue-500 leading-relaxed"><%= article.content || '' %></textarea>
                    </div>
                    <div class="flex items-center justify-between pt-4 border-t border-slate-800">
                        <div class="flex items-center gap-4">
                            <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                Yayın Durumu:
                            </label>
                            <select name="status"
                                class="bg-slate-900 border border-slate-800 text-sm text-white rounded-lg px-3 py-2 focus:outline-none">
                                <option value="0" <%=article.status===0 ? 'selected' : '' %>>
                                    Taslak
                                </option>
                                <option value="1" <%=article.status===1 ? 'selected' : '' %>>
                                    Yayınla
                                </option>
                            </select>
                        </div>
                        <div class="flex items-center gap-4">
                            <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                Dil:
                            </label>
                            <select name="language"
                                class="bg-slate-900 border border-slate-800 text-sm text-white rounded-lg px-3 py-2 focus:outline-none">
                                <option value="tr" <%=article.language==='tr' ? 'selected' : '' %>>
                                    Türkçe
                                </option>
                                <option value="en" <%=article.language==='en' ? 'selected' : '' %>>
                                    İngilizce
                                </option>
                            </select>
                        </div>
                        <button type="submit"
                            class="px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-sm font-medium transition-colors">
                            <%= article.id ? 'Değişiklikleri Kaydet' : 'Makaleyi Kaydet' %>
                        </button>
                    </div>
                </form>
            </main>
    </div>
    <%- include('../partials/footer') %>