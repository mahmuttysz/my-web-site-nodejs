<%- include('../partials/header') %>
    <div class="flex min-h-screen">
        <%- include('../partials/sidebar') %>
            <main class="flex-1 p-8 overflow-y-auto">
                <header class="flex items-center justify-between mb-8">
                    <div>
                        <h1 class="text-2xl font-bold text-white">
                            Makale Yönetimi
                        </h1>
                        <p class="text-slate-400 text-sm mt-1">
                            Blog içeriklerinizi buradan yönetebilirsiniz.
                        </p>
                    </div>
                    <a href="<%=adminEndpoint%>/articles/new"
                        class="px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-sm font-medium transition-colors">
                        + Yeni Makale Ekle
                    </a>
                </header>
                <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
                    <table class="w-full text-left text-sm text-slate-300">
                        <thead class="bg-slate-950 border-b border-slate-800 text-xs uppercase text-slate-400">
                            <tr>
                                <th class="px-6 py-4">#</th>
                                <th class="px-6 py-4">Başlık</th>
                                <th class="px-6 py-4">Durum</th>
                                <th class="px-6 py-4">Okunma Sayısı</th>
                                <th class="px-6 py-4">Oluşturulma Tarihi</th>
                                <th class="px-6 py-4">Yayınlanma Tarihi</th>
                                <th class="px-6 py-4">Dil</th>
                                <th class="px-6 py-4 text-right">Aksiyonlar</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            <% if (articles && articles.length> 0) { %>
                                <% articles.forEach((art, i)=> { %>
                                    <tr class="hover:bg-slate-800/30">
                                        <td class="px-6 py-4 text-slate-400">
                                            <%= i+1 %>
                                        </td>
                                        <td class="px-6 py-4 font-medium text-white max-w-md truncate">
                                            <%= art.title %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span
                                                class="px-2.5 py-1 rounded-full text-xs font-semibold <%= art.status === 'published' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-slate-800 text-slate-400' %>">
                                                <%= art.status===1 ? 'Yayınlandı' : 'Taslak' %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <%= art.hits %>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <%= formatLongDateTime(art.created_at) %>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <%= art.published_at && art.published_at !==null ?
                                                formatLongDateTime(art.published_at) : '-' %>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <%= art.language || 'Türkçe' %>
                                        </td>
                                        <td class="px-6 py-4 text-right space-x-2">
                                            <a href="<%=adminEndpoint%>/articles/edit/<%= art.id %>"
                                                class="text-blue-400 hover:text-blue-300 font-medium text-xs">
                                                Düzenle
                                            </a>
                                            <button data-article-id="<%= art.id %>" admin-endpoint="<%=adminEndpoint%>"
                                                class="btn-delete-article text-red-400 hover:text-red-300 font-medium text-xs">
                                                Sil
                                            </button>
                                        </td>
                                    </tr>
                                    <% }); } else { %>
                                        <tr>
                                            <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                                                Henüz makale eklenmemiş.</td>
                                        </tr>
                                        <% } %>
                        </tbody>
                    </table>
                </div>
            </main>
    </div>
    <%- include('../partials/footer') %>