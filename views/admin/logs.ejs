<%- include('partials/header') %>
    <div class="flex min-h-screen flex-col lg:flex-row">
        <%- include('partials/sidebar') %>

            <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8 overflow-y-auto">
                <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6 lg:mb-8">
                    <div>
                        <h1 class="text-xl sm:text-2xl font-bold text-white">İşlem ve Güvenlik Logları</h1>
                        <p class="text-slate-400 text-sm mt-1">Yönetici paneli girişleri, güvenlik olayları ve içerik değişiklikleri.</p>
                    </div>

                    <% if (logs && logs.length > 0) { %>
                    <form action="<%=adminEndpoint%>/logs/clean" method="POST" onsubmit="return confirm('60 günden eski kayıtlar kalıcı olarak silinecek. Onaylıyor musunuz?');" class="m-0">
                        <%- include('partials/csrf') %>
                        <input type="hidden" name="days" value="60">
                        <button type="submit" class="inline-flex items-center gap-2 px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded-lg text-xs font-medium transition-colors border border-slate-700/60">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                            Eski Logları Temizle (60+ Gün)
                        </button>
                    </form>
                    <% } %>
                </header>

                <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
                    <% if (logs && logs.length > 0) { %>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm text-slate-300">
                                <thead class="bg-slate-950/70 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-800">
                                    <tr>
                                        <th scope="col" class="px-4 py-3 sm:px-6">Tarih</th>
                                        <th scope="col" class="px-4 py-3 sm:px-6">İşlem</th>
                                        <th scope="col" class="px-4 py-3 sm:px-6">Kullanıcı</th>
                                        <th scope="col" class="px-4 py-3 sm:px-6">Açıklama</th>
                                        <th scope="col" class="px-4 py-3 sm:px-6">IP / Cihaz</th>
                                        <th scope="col" class="px-4 py-3 sm:px-6">Detay</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800/80">
                                    <% logs.forEach(log => { %>
                                        <% 
                                            let badgeClass = 'bg-slate-500/10 text-slate-400 border-slate-500/20';
                                            if (log.action === 'LOGIN_SUCCESS') {
                                                badgeClass = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
                                            } else if (log.action === 'LOGIN_FAILED' || log.action.endsWith('_DELETE')) {
                                                badgeClass = 'bg-red-500/10 text-red-400 border-red-500/20';
                                            } else if (log.action.endsWith('_CREATE')) {
                                                badgeClass = 'bg-blue-500/10 text-blue-400 border-blue-500/20';
                                            } else if (log.action.endsWith('_UPDATE') || log.action === 'ABOUT_UPDATE') {
                                                badgeClass = 'bg-amber-500/10 text-amber-400 border-amber-500/20';
                                            }
                                        %>
                                        <tr class="hover:bg-slate-800/40 transition-colors">
                                            <td class="px-4 py-3 sm:px-6 text-xs text-slate-400 whitespace-nowrap">
                                                <%= formatLongDateTime(log.created_at) %>
                                            </td>
                                            <td class="px-4 py-3 sm:px-6 whitespace-nowrap">
                                                <span class="inline-block px-2 py-0.5 rounded-full text-[11px] font-semibold tracking-wider border <%= badgeClass %>">
                                                    <%= log.action %>
                                                </span>
                                            </td>
                                            <td class="px-4 py-3 sm:px-6 text-xs font-medium text-white whitespace-nowrap">
                                                <%= log.username || '-' %>
                                            </td>
                                            <td class="px-4 py-3 sm:px-6 text-xs text-slate-200 min-w-[200px]">
                                                <%= log.description %>
                                            </td>
                                            <td class="px-4 py-3 sm:px-6 text-xs text-slate-400 whitespace-nowrap">
                                                <div class="font-mono text-[11px] text-slate-300"><%= log.ip || '-' %></div>
                                                <% if (log.user_agent) { %>
                                                    <div class="text-[10px] text-slate-500 max-w-[150px] truncate" title="<%= log.user_agent %>">
                                                        <%= log.user_agent %>
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td class="px-4 py-3 sm:px-6 text-xs">
                                                <% if (log.details) { %>
                                                    <details class="cursor-pointer">
                                                        <summary class="text-[11px] text-blue-400 hover:text-blue-300 font-medium select-none">
                                                            JSON
                                                        </summary>
                                                        <pre class="mt-2 p-2 bg-slate-950 rounded text-[10px] font-mono text-slate-300 max-w-xs overflow-x-auto border border-slate-800"><%= typeof log.details === 'string' ? log.details : JSON.stringify(log.details, null, 2) %></pre>
                                                    </details>
                                                <% } else { %>
                                                    <span class="text-slate-600">-</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="p-8 text-center text-slate-500 text-sm">
                            Kayıtlı herhangi bir işlem logu bulunmuyor.
                        </div>
                    <% } %>
                </div>
            </main>
    </div>
<%- include('partials/footer') %>
