<div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 <%= typeof align !== 'undefined' && align === 'end' ? 'justify-end' : '' %>">
    <a href="<%= editHref %>" class="text-blue-400 hover:text-blue-300 font-medium text-xs">
        Düzenle
    </a>
    <button type="button" admin-endpoint="<%= adminEndpoint %>" page-endpoint="<%= pageEndpoint %>"
        data-id="<%= itemId %>"
        class="btn-delete text-red-400 hover:text-red-300 font-medium text-xs">
        Sil
    </button>
</div>
