<%- include('partials/header') %>
    <div class="flex min-h-screen flex-col lg:flex-row">
        <%- include('partials/sidebar') %>

            <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8 overflow-y-auto">
                <header class="mb-6 lg:mb-8">
                    <h1 class="text-xl sm:text-2xl font-bold text-white">Gelen İletişim Mesajları</h1>
                    <p class="text-slate-400 text-sm mt-1">Siteden gönderilen tüm mesajlar aşağıda listelenmektedir.</p>
                </header>
                <div class="space-y-4 max-w-4xl">
                    <% if (messages && messages.length> 0) { %>
                        <% const unreadCount=messages.filter(m=> Number(m.is_read) === 0).length; %>
                        <% if (unreadCount> 0) { %>
                            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between bg-slate-900 border border-slate-800 rounded-xl p-4">
                                <label class="flex items-center gap-2 text-sm text-slate-300">
                                    <input type="checkbox" id="msg-select-all"
                                        class="rounded border-slate-600 bg-slate-800 text-blue-500">
                                    <span>Okunmamışları seç (<%= unreadCount %>)</span>
                                </label>
                                <button type="button" id="btn-mark-selected" admin-endpoint="<%=adminEndpoint%>"
                                    class="inline-flex justify-center px-3 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-xs font-medium">
                                    Seçilenleri okundu işaretle
                                </button>
                            </div>
                        <% } %>
                        <% messages.forEach(msg=> { %>
                            <% const unread=Number(msg.is_read)===0; %>
                            <div class="bg-slate-900 border rounded-xl p-4 sm:p-6 <%= unread ? 'border-amber-500/30' : 'border-slate-800' %>">
                                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between border-b border-slate-800/80 pb-4 mb-4">
                                    <div class="min-w-0 flex items-start gap-3">
                                        <% if (unread) { %>
                                            <input type="checkbox" class="msg-select mt-1 rounded border-slate-600 bg-slate-800 text-blue-500"
                                                value="<%= msg.id %>">
                                        <% } %>
                                        <div class="min-w-0">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <h3 class="font-bold text-white text-base">
                                                    <%= msg.full_name %>
                                                </h3>
                                                <% if (unread) { %>
                                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                                        Okunmadı
                                                    </span>
                                                <% } else { %>
                                                    <span class="text-[10px] uppercase tracking-wider text-slate-500">
                                                        Okundu
                                                    </span>
                                                <% } %>
                                            </div>
                                            <a href="mailto:<%= msg.email %>" class="text-xs text-blue-400 hover:underline break-all">
                                                <%= msg.email %>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-4 shrink-0">
                                        <span class="text-xs text-slate-500">
                                            <%= formatLongDateTime(msg.created_at) %>
                                        </span>
                                        <% if (unread) { %>
                                            <button type="button" admin-endpoint="<%=adminEndpoint%>"
                                                data-id="<%= msg.id %>"
                                                class="btn-mark-read text-xs text-blue-400 hover:text-blue-300 font-medium">
                                                Okundu
                                            </button>
                                        <% } %>
                                        <button type="button" admin-endpoint="<%=adminEndpoint%>" page-endpoint="messages"
                                            data-id="<%= msg.id %>"
                                            class="btn-delete text-xs text-red-400 hover:text-red-300 font-medium">
                                            Sil
                                        </button>
                                    </div>
                                </div>
                                <% if (msg.subject) { %>
                                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Konu:
                                        <%= msg.subject %>
                                    </p>
                                    <% } %>
                                        <p class="text-slate-300 text-sm leading-relaxed whitespace-pre-line">
                                            <%= msg.message %>
                                        </p>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div
                                        class="bg-slate-900 border border-slate-800 rounded-xl p-12 text-center text-slate-500">
                                        Gelen kutunuzda henüz bir mesaj bulunmuyor.
                                    </div>
                                    <% } %>
                </div>
            </main>
    </div>

    <%- include('partials/footer') %>
