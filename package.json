{
  "name": "my-website-nodejs",
  "version": "1.0.0",
  "description": "TypeScript Express & MariaDB Portfolio Engine",
  "main": "dist/app.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test ./test/i18n.test.ts ./test/helper.test.ts ./test/markdown.test.ts ./test/loginLock.test.ts ./test/health.test.ts ./test/sitemap.test.ts ./test/csrf-preview.test.ts ./test/articleTranslation.test.ts ./test/articleHits.test.ts ./test/hardening.test.ts",
    "build": "tsc && npm run build:css",
    "start": "node dist/app.js",
    "dev": "concurrently -k -n ts,css -c cyan,magenta npm:dev:server npm:watch:css",
    "dev:server": "tsx watch src/app.ts",
    "seed:admin": "tsx scripts/create-admin.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/style.css --watch --silent"
  },
  "keywords": [],
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mariadb": "^3.5.4",
    "marked": "^18.0.14",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "sanitize-html": "^2.17.7",
    "slugify": "^1.6.9"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "tailwindcss@4.3.3": true,
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.2": true
  }
}
