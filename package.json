{
  "name": "my-website-nodejs",
  "version": "1.0.0",
  "description": "",
  "eslintConfig": {
    "$schema": "https://json.schemastore.org/eslintrc.json",
    "allowTrailingComma": true
  },
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon -e js,ejs,json,css app.js",
    "seed:admin": "node scripts/createAdmin.js",
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/css/style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/css/style.css --watch"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mariadb": "^3.5.3",
    "marked": "^18.0.7",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "path": "^0.12.7",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "tailwindcss@4.3.3": true,
    "@parcel/watcher@2.5.1": true
  }
}
