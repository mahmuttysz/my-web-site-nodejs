{
  "name": "my-website-nodejs",
  "version": "1.0.0",
  "description": "TypeScript Express & MariaDB Portfolio Engine",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc && npm run build:css",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "seed:admin": "tsx scripts/create-admin.ts",
    "db:import": "mysql -u root -p website < DumpSQL.sql",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/style.css --watch"
  },
  "keywords": [],
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mariadb": "^3.5.3",
    "marked": "^18.0.10",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "slugify": "^1.6.9"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "tailwindcss@4.3.3": true,
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.2": true
  }
}