<%- include('../partials/header') %>
    <div class="flex min-h-screen">
        <%- include('../partials/sidebar') %>
            <main class="flex-1 p-8 overflow-y-auto">
                <header class="flex items-center justify-between mb-8">
                    <div>
                        <h1 class="text-2xl font-bold text-white">
                            Proje Yönetimi
                        </h1>
                    </div>
                    <a href="<%=adminEndpoint%>/projects/new"
                        class="px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-sm font-medium transition-colors">
                        + Proje Ekle
                    </a>
                </header>
                <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
                    <table class="w-full text-left text-sm text-slate-300">
                        <thead class="bg-slate-950 border-b border-slate-800 text-xs uppercase text-slate-400">
                            <tr>
                                <th class="px-6 py-4">#</th>
                                <th class="px-6 py-4">Başlık</th>
                                <th class="px-6 py-4">Link</th>
                                <th class="px-6 py-4">Tags</th>
                                <th class="px-6 py-4">Oluşturulma Tarihi</th>
                                <th class="px-6 py-4">Dil</th>
                                <th class="px-6 py-4">Durum</th>
                                <th class="px-6 py-4 text-right">Aksiyonlar</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            <% if (projects && projects.length> 0) { %>
                                <% projects.forEach((prj, i)=> { %>
                                    <tr class="hover:bg-slate-800/30">
                                        <td class="px-6 py-4 text-slate-400">
                                            <%= i+1 %>
                                        </td>
                                        <td class="px-6 py-4 font-medium text-white max-w-md truncate">
                                            <%= prj.title %>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <a href="<%= prj.link_url %>" target="_blank">
                                                <%= prj.link_text %> ↗
                                            </a>
                                        </td>
                                        <td class="px-6 py-4">
                                            <% if(prj.tags && prj.tags.length> 0) { prj.tags?.forEach(tag => { %>
                                                <span
                                                    class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-800 text-slate-400">
                                                    <%= tag %>
                                                </span>
                                                <% }); } else {%>
                                                    -
                                                    <% }%>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <%= formatLongDateTime(prj.created_at) %>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <%= prj.language || 'Türkçe' %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold 
                                                <%= prj.status === 1 ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' 
                                                : 'bg-slate-800 text-slate-400' %>">
                                                <%= prj.status===1 ? 'Aktif' : 'Pasif' %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-right space-x-2">
                                            <a href="<%=adminEndpoint%>/projects/edit/<%= prj.id %>"
                                                class="text-blue-400 hover:text-blue-300 font-medium text-xs">
                                                Düzenle
                                            </a>
                                            <button admin-endpoint="<%=adminEndpoint%>" page-endpoint="projects"
                                                data-id="<%= prj.id %>"
                                                class="btn-delete text-red-400 hover:text-red-300 font-medium text-xs">
                                                Sil
                                            </button>
                                        </td>
                                    </tr>
                                    <% }); } else { %>
                                        <tr>
                                            <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                                                Henüz proje eklenmemiş.</td>
                                        </tr>
                                        <% } %>
                        </tbody>
                    </table>
                </div>
            </main>
    </div>
    <%- include('../partials/footer') %>