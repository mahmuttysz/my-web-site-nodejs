<%- include('../partials/header') %>
    <div class="flex min-h-screen">
        <%- include('../partials/sidebar') %>
            <main class="flex-1 p-8 overflow-y-auto">
                <header class="flex items-center justify-between mb-8">
                    <div>
                        <h1 class="text-2xl font-bold text-white">
                            Sosyal Medya Yönetimi
                        </h1>
                    </div>
                    <a href="<%=adminEndpoint%>/social-medias/new"
                        class="px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-sm font-medium transition-colors">
                        + Sosyal Medya Ekle
                    </a>
                </header>
                <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
                    <table class="w-full text-left text-sm text-slate-300">
                        <thead class="bg-slate-950 border-b border-slate-800 text-xs uppercase text-slate-400">
                            <tr>
                                <th class="px-6 py-4">#</th>
                                <th class="px-6 py-4">Başlık</th>
                                <th class="px-6 py-4">Kullanıcı Adı</th>
                                <th class="px-6 py-4">Link</th>
                                <th class="px-6 py-4">İkon</th>
                                <th class="px-6 py-4">Oluşturulma Tarihi</th>
                                <th class="px-6 py-4">Durum</th>
                                <th class="px-6 py-4 text-right">Aksiyonlar</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            <% if (socialMedias && socialMedias.length> 0) { %>
                                <% socialMedias.forEach((sMedia, i)=> { %>
                                    <tr class="hover:bg-slate-800/30">
                                        <td class="px-6 py-4 text-slate-400">
                                            <%= i+1 %>
                                        </td>
                                        <td class="px-6 py-4 font-medium text-white max-w-md truncate">
                                            <%= sMedia.title %>
                                        </td>
                                        <td class="px-6 py-4 font-medium text-white max-w-md truncate">
                                            <%= sMedia.username %>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <a href="<%= sMedia.url %>" target="_blank">
                                                <span
                                                    class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                                    ↗
                                                </span>
                                            </a>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <%- sMedia.icon %>
                                        </td>
                                        <td class="px-6 py-4 text-slate-400">
                                            <%= formatLongDateTime(sMedia.created_at) %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold 
                                                <%= sMedia.status === 1 ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' 
                                                : 'bg-slate-800 text-slate-400' %>">
                                                <%= sMedia.status===1 ? 'Aktif' : 'Pasif' %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-right space-x-2">
                                            <a href="<%=adminEndpoint%>/social-medias/edit/<%= sMedia.id %>"
                                                class="text-blue-400 hover:text-blue-300 font-medium text-xs">
                                                Düzenle
                                            </a>
                                            <button admin-endpoint="<%=adminEndpoint%>" page-endpoint="social-medias"
                                                data-id="<%= sMedia.id %>"
                                                class="btn-delete text-red-400 hover:text-red-300 font-medium text-xs">
                                                Sil
                                            </button>
                                        </td>
                                    </tr>
                                    <% }); } else { %>
                                        <tr>
                                            <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                                                Henüz sosyal medya eklenmemiş.</td>
                                        </tr>
                                        <% } %>
                        </tbody>
                    </table>
                </div>
            </main>
    </div>
    <%- include('../partials/footer') %>